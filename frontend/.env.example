# Frontend environment template. Copy to frontend/.env.local.
VITE_API_URL=http://localhost:5000/api

# Optional: WhatsApp number for the landing "Chat on WhatsApp" button (international format, no +), e.g. 233241234567
VITE_WHATSAPP_NUMBER=

# Optional: live co-writing websocket. Defaults to the API host (wss://researchpadi.onrender.com/api/collab in production),
# since Vercel cannot proxy websockets.
VITE_COLLAB_URL=
