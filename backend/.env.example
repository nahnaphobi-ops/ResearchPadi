# Backend environment template. Copy to backend/.env and fill in real values.
# Never commit .env.

NODE_ENV=development
PORT=5000

# Required
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=

# Required in production
DATABASE_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD=
FRONTEND_URL=http://localhost:5173

# Recommended
REDIS_URL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
PAYSTACK_SECRET_KEY=
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=papers
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Optional
METRICS_TOKEN=
ALLOW_DEMO_LOGIN=true
DEMO_PHONE=+233200000000
DEMO_OTP=123456
GLOBAL_RATE_LIMIT=200
LOG_LEVEL=debug
