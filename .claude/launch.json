{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "backend",
        "run",
        "dev"
      ],
      "port": 5000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "backend-e2e",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "backend/scripts/e2e-offline.mjs"
      ],
      "port": 5000
    },
    {
      "name": "frontend-e2e",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set VITE_API_URL=http://localhost:5001/api&& npm --prefix frontend run dev -- --port 5174 --strictPort"
      ],
      "port": 5174,
      "autoPort": false
    }
  ]
}
