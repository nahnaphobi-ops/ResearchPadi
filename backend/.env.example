# Backend environment template. Copy to backend/.env and fill in real values.
# Never commit .env.

NODE_ENV=development
PORT=5000

# Required
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=

# Required in production
DATABASE_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Admin two-factor codes are sent here by SMS (needs Arkesel below)
ADMIN_PHONE=
FRONTEND_URL=http://localhost:5173

# Recommended
REDIS_URL=
ANTHROPIC_API_KEY=
# AI review of finished papers (src/services/review). Suggestions only: the paper
# changes only when the student accepts one. Prices: src/services/review/pricing.json.
# REVIEW_ENABLED=false turns off the automatic review after generation.
REVIEW_ENABLED=true
REVIEW_READER_MODEL=claude-haiku-5-5
REVIEW_SUPERVISOR_MODEL=claude-opus-5-5
# Second supervisor for admin compare mode
REVIEW_COMPARE_MODEL=claude-fable-5-2
REVIEW_MAX_PASSES=1
REVIEW_SUPERVISOR_MAX_TOKENS=8000
REVIEW_READER_MAX_TOKENS=16000
REVIEW_MAX_SUGGESTIONS=40
# Over this many prompt tokens the reader keeps the top-ranked sources or splits by chapter
REVIEW_READER_TOKEN_BUDGET=90000
# Optional effort for each stage: low | medium | high | xhigh | max (unset = model default)
REVIEW_READER_EFFORT=
REVIEW_SUPERVISOR_EFFORT=
# API attempts per call on 429 or overloaded errors
REVIEW_RETRY_ATTEMPTS=4
# Review jobs one worker runs at the same time
REVIEW_CONCURRENCY=2
USD_TO_GHS=12.5
# Embeddings for the library (an OpenAI sk-... key, or an OpenRouter sk-or-... key).
# `npm run rag:verify` shows whether it works; without it chunks are stored without vectors.
OPENAI_API_KEY=
# Free key from https://openalex.org/settings/api. Without it OpenAlex shares a tiny daily
# budget with everyone on the server's IP and refuses cursor paging (HTTP 401).
OPENALEX_API_KEY=
# The library harvest stops when the database reaches this size (MB). 400 suits Supabase
# Free (500 MB); raise it after upgrading (e.g. 7000 on Pro). 0 turns the check off.
HARVEST_DB_LIMIT_MB=400
PERPLEXITY_API_KEY=
PAYSTACK_SECRET_KEY=
# Arkesel SMS for phone OTP (https://sms.arkesel.com → SMS API). Without these,
# dev logs the code instead and production refuses OTP requests.
ARKESEL_API_KEY=
# Sender ID approved in your Arkesel dashboard, max 11 characters (e.g. RsrchPadi)
ARKESEL_SENDER_ID=
# true = Arkesel accepts requests but doesn't deliver or charge (for testing)
ARKESEL_SANDBOX=false
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=papers
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Optional
METRICS_TOKEN=
ALLOW_DEMO_LOGIN=true
DEMO_PHONE=+233200000000
DEMO_OTP=123456
GLOBAL_RATE_LIMIT=200
LOG_LEVEL=debug
# Error tracking (Sentry). Every error and fatal log line is reported when this is set.
# Leave empty for local work.
SENTRY_DSN=
